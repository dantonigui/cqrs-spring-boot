# Copy to .env; use unique credentials. Never commit .env.
DB_COMMAND_USER=cqrs_command
DB_COMMAND_PASSWORD=replace-command-password
DB_QUERY_USER=cqrs_query
DB_QUERY_PASSWORD=replace-query-password
DB_ROOT_PASSWORD=replace-root-password
DB_COMMAND_URL_SQL=jdbc:mysql://localhost:3307/cqrs_command?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_QUERY_URL_SQL=jdbc:mysql://localhost:3308/cqrs_query?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_COMMAND_POOL_SIZE=20
DB_QUERY_POOL_SIZE=20
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-redis-password
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
GOOGLE_ID=replace-google-client-id
GOOGLE_SECRET=replace-google-client-secret
GOOGLE_URL=http://localhost:8080/login/oauth2/code/google
MY_EMAIL_ADMIN=admin@example.com
COOKIE_NAME=access_token
COOKIE_MAX_AGE=900
COOKIE_SECURE=false
JWT_SECRET=replace-with-base64-of-at-least-32-random-bytes
JWT_EXPIRATION_MS=900000
APP_FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:8080
MP_ACCESS_TOKEN=replace-mercado-pago-test-access-token
MP_PUBLIC_KEY=replace-mercado-pago-test-public-key
MP_WEBHOOK_SECRET=replace-mercado-pago-webhook-secret
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=replace-mail-user
MAIL_PASSWORD=replace-mail-password
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Loja CQRS
# Optional host ports: APP_PORT=8080 DB_COMMAND_PORT=3307 DB_QUERY_PORT=3308 KAFKA_PORT=9092